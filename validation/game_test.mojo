def test_plan() -> String:
    var result = "Initial generated-game test checklist:\n"
    result += "- Project files exist\n"
    result += "- Main scene opens\n"
    result += "- Player can start and move\n"
    result += "- Main mechanic works\n"
    result += "- No blocking errors appear\n"
    result += "- Win/loss or progression condition is reachable"
    return result
