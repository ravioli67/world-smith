{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldSmith Game Specification",
  "type": "object",
  "required": [
    "prompt",
    "genre",
    "perspective",
    "features"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "perspective": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_engine": {
      "type": "string",
      "default": "Godot"
    }
  },
  "additionalProperties": false
}